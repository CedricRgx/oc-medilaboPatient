version: "3.9"

services:
  eureka-server:
    image: ms-eureka-server:latest
    build:
      context: ./ms-eureka-server
      dockerfile: dockerfile
    container_name: eureka-server
    ports:
      - "8761:8761"
    networks:
      - medilabo-network

  client-ui:
    image: ms-client-ui:latest
    build:
      context: ./ms-client-ui
      dockerfile: dockerfile
    container_name: client-ui
    ports:
      - "8080:8080"
    depends_on:
      - eureka-server
    networks:
      - medilabo-network

  patient:
    image: ms-patient:latest
    build:
      context: ./ms-patient
      dockerfile: dockerfile
    container_name: ms-patient
    ports:
      - "8081:8081"
    depends_on:
      - eureka-server
    networks:
      - medilabo-network

  diabete:
    image: ms-diabete:latest
    build:
      context: ./ms-diabete
      dockerfile: dockerfile
    container_name: ms-diabete
    ports:
      - "8084:8084"
    depends_on:
      - eureka-server
    networks:
      - medilabo-network

  note:
    image: ms-note:latest
    build:
      context: ./ms-note
      dockerfile: dockerfile
    container_name: ms-note
    ports:
      - "8083:8083"
    depends_on:
      - eureka-server
    networks:
      - medilabo-network

  gateway-server:
    image: ms-gateway-server:latest
    build:
      context: ./ms-gateway-server
      dockerfile: dockerfile
    container_name: gateway-server
    ports:
      - "8082:8082"
    depends_on:
      - eureka-server
    networks:
      - medilabo-network

networks:
  medilabo-network:
    driver: bridge